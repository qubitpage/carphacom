"use client"

import { useState, useActionState } from "react"
import { loginForCheckout, signupForCheckout } from "@lib/data/checkout-auth"
import Input from "@modules/common/components/input"
import ErrorMessage from "@modules/checkout/components/error-message"
import { SubmitButton } from "@modules/checkout/components/submit-button"
import LocalizedClientLink from "@modules/common/components/localized-client-link"

type CheckoutView = "options" | "login" | "register"

const GoogleIcon = () => (
  <svg className="w-5 h-5" viewBox="0 0 24 24">
    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
  </svg>
)

const CheckoutAuthPrompt = () => {
  const [currentView, setCurrentView] = useState<CheckoutView>("options")
  const [loginMessage, loginAction] = useActionState(loginForCheckout, null)
  const [signupMessage, signupAction] = useActionState(signupForCheckout, null)

  const handleGoogleLogin = () => {
    window.location.href = '/api/auth/google?country=ro&redirect=checkout'
  }

  if (currentView === "options") {
    return (
      <div className="bg-dark-800 border border-dark-700 rounded-xl p-6 mb-6">
        <div className="flex items-center gap-3 mb-4">
          <div className="w-10 h-10 bg-primary-500/20 rounded-full flex items-center justify-center">
            <svg className="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
          <div>
            <h2 className="text-lg font-semibold text-white">Cum dorești să continui?</h2>
            <p className="text-sm text-dark-400">Alege o opțiune pentru a finaliza comanda</p>
          </div>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {/* Google Login Option */}
          <button
            onClick={handleGoogleLogin}
            className="group p-4 bg-white hover:bg-gray-50 border border-dark-600 hover:border-blue-400/50 rounded-lg transition-all text-left sm:col-span-2"
            data-testid="checkout-google-option"
          >
            <div className="flex items-center gap-3 justify-center">
              <GoogleIcon />
              <span className="font-medium text-gray-700">Continuă cu Google</span>
            </div>
          </button>

          {/* Guest Option */}
          <button
            onClick={() => setCurrentView("options")}
            className="group p-4 bg-dark-700 hover:bg-dark-600 border border-dark-600 hover:border-primary-500/50 rounded-lg transition-all text-left"
            data-testid="continue-as-guest"
          >
            <div className="flex items-center gap-2 mb-2">
              <svg className="w-5 h-5 text-dark-400 group-hover:text-primary-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
              <span className="font-medium text-white">Continuă ca oaspete</span>
            </div>
            <p className="text-xs text-dark-400">Finalizează rapid fără cont</p>
          </button>

          {/* Login Option */}
          <button
            onClick={() => setCurrentView("login")}
            className="group p-4 bg-dark-700 hover:bg-dark-600 border border-dark-600 hover:border-primary-500/50 rounded-lg transition-all text-left"
            data-testid="checkout-login-option"
          >
            <div className="flex items-center gap-2 mb-2">
              <svg className="w-5 h-5 text-dark-400 group-hover:text-primary-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
              </svg>
              <span className="font-medium text-white">Am cont</span>
            </div>
            <p className="text-xs text-dark-400">Autentifică-te pentru beneficii</p>
          </button>

          {/* Register Option */}
          <button
            onClick={() => setCurrentView("register")}
            className="group p-4 bg-dark-700 hover:bg-dark-600 border border-dark-600 hover:border-accent-500/50 rounded-lg transition-all text-left"
            data-testid="checkout-register-option"
          >
            <div className="flex items-center gap-2 mb-2">
              <svg className="w-5 h-5 text-dark-400 group-hover:text-accent-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
              </svg>
              <span className="font-medium text-white">Creează cont</span>
            </div>
            <p className="text-xs text-dark-400">Beneficiază de oferte exclusive</p>
          </button>
        </div>

        <div className="mt-4 p-3 bg-primary-500/10 border border-primary-500/20 rounded-lg">
          <p className="text-xs text-primary-300 flex items-center gap-2">
            <svg className="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Cu un cont poți urmări comenzile, salva adrese și primi oferte personalizate.</span>
          </p>
        </div>
      </div>
    )
  }

  if (currentView === "login") {
    return (
      <div className="bg-dark-800 border border-dark-700 rounded-xl p-6 mb-6">
        <div className="flex items-center justify-between mb-4">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 bg-primary-500/20 rounded-full flex items-center justify-center">
              <svg className="w-5 h-5 text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
              </svg>
            </div>
            <div>
              <h2 className="text-lg font-semibold text-white">Autentificare</h2>
              <p className="text-sm text-dark-400">Intră în contul tău pentru a continua</p>
            </div>
          </div>
          <button
            onClick={() => setCurrentView("options")}
            className="text-dark-400 hover:text-white transition-colors"
            data-testid="back-to-options"
          >
            <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        {/* Google Login Button */}
        <button
          onClick={handleGoogleLogin}
          className="w-full flex items-center justify-center gap-3 py-2.5 px-4 border border-dark-600 rounded-lg bg-white hover:bg-gray-50 transition-colors font-medium text-gray-700 mb-4"
          data-testid="checkout-google-login"
        >
          <GoogleIcon />
          <span className="text-sm">Continuă cu Google</span>
        </button>

        <div className="relative w-full mb-4">
          <div className="absolute inset-0 flex items-center">
            <div className="w-full border-t border-dark-600"></div>
          </div>
          <div className="relative flex justify-center text-xs">
            <span className="bg-dark-800 px-3 text-dark-400">sau cu email</span>
          </div>
        </div>

        <form action={loginAction} className="space-y-4">
          <Input
            label="Email"
            name="email"
            type="email"
            autoComplete="email"
            required
            data-testid="checkout-login-email"
          />
          <Input
            label="Parolă"
            name="password"
            type="password"
            autoComplete="current-password"
            required
            data-testid="checkout-login-password"
          />
          <ErrorMessage error={loginMessage} data-testid="checkout-login-error" />
          
          <div className="flex gap-3">
            <button
              type="button"
              onClick={() => setCurrentView("options")}
              className="flex-1 h-10 bg-dark-700 hover:bg-dark-600 text-white font-medium rounded-lg transition-colors"
            >
              Înapoi
            </button>
            <SubmitButton
              className="flex-1 h-10 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-medium rounded-lg"
              data-testid="checkout-login-submit"
            >
              Autentificare
            </SubmitButton>
          </div>
        </form>

        <div className="mt-4 text-center">
          <span className="text-sm text-dark-400">
            Nu ai cont?{" "}
            <button
              onClick={() => setCurrentView("register")}
              className="text-primary-400 hover:text-primary-300 font-medium"
            >
              Înregistrează-te
            </button>
          </span>
        </div>
      </div>
    )
  }

  // Register view
  return (
    <div className="bg-dark-800 border border-dark-700 rounded-xl p-6 mb-6">
      <div className="flex items-center justify-between mb-4">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 bg-accent-500/20 rounded-full flex items-center justify-center">
            <svg className="w-5 h-5 text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
          </div>
          <div>
            <h2 className="text-lg font-semibold text-white">Creează cont</h2>
            <p className="text-sm text-dark-400">Înregistrează-te pentru beneficii exclusive</p>
          </div>
        </div>
        <button
          onClick={() => setCurrentView("options")}
          className="text-dark-400 hover:text-white transition-colors"
          data-testid="back-to-options-register"
        >
          <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      {/* Google Signup Button */}
      <button
        onClick={handleGoogleLogin}
        className="w-full flex items-center justify-center gap-3 py-2.5 px-4 border border-dark-600 rounded-lg bg-white hover:bg-gray-50 transition-colors font-medium text-gray-700 mb-4"
        data-testid="checkout-google-register"
      >
        <GoogleIcon />
        <span className="text-sm">Înregistrează-te cu Google</span>
      </button>

      <div className="relative w-full mb-4">
        <div className="absolute inset-0 flex items-center">
          <div className="w-full border-t border-dark-600"></div>
        </div>
        <div className="relative flex justify-center text-xs">
          <span className="bg-dark-800 px-3 text-dark-400">sau cu email</span>
        </div>
      </div>

      <form action={signupAction} className="space-y-4">
        <div className="grid grid-cols-2 gap-4">
          <Input
            label="Prenume"
            name="first_name"
            required
            autoComplete="given-name"
            data-testid="checkout-register-first-name"
          />
          <Input
            label="Nume"
            name="last_name"
            required
            autoComplete="family-name"
            data-testid="checkout-register-last-name"
          />
        </div>
        <Input
          label="Email"
          name="email"
          required
          type="email"
          autoComplete="email"
          data-testid="checkout-register-email"
        />
        <Input
          label="Telefon"
          name="phone"
          type="tel"
          autoComplete="tel"
          data-testid="checkout-register-phone"
        />
        <Input
          label="Parolă"
          name="password"
          required
          type="password"
          autoComplete="new-password"
          data-testid="checkout-register-password"
        />
        
        <ErrorMessage error={signupMessage} data-testid="checkout-register-error" />
        
        <p className="text-xs text-dark-500">
          Prin crearea unui cont, ești de acord cu{" "}
          <LocalizedClientLink
            href="/confidentialitate"
            className="text-primary-400 hover:text-primary-300"
          >
            Politica de confidențialitate
          </LocalizedClientLink>{" "}
          și{" "}
          <LocalizedClientLink
            href="/termeni"
            className="text-primary-400 hover:text-primary-300"
          >
            Termenii și condițiile
          </LocalizedClientLink>
          .
        </p>

        <div className="flex gap-3">
          <button
            type="button"
            onClick={() => setCurrentView("options")}
            className="flex-1 h-10 bg-dark-700 hover:bg-dark-600 text-white font-medium rounded-lg transition-colors"
          >
            Înapoi
          </button>
          <SubmitButton
            className="flex-1 h-10 bg-gradient-to-r from-accent-500 to-accent-600 hover:from-accent-600 hover:to-accent-700 text-white font-medium rounded-lg"
            data-testid="checkout-register-submit"
          >
            Înregistrare
          </SubmitButton>
        </div>
      </form>

      <div className="mt-4 text-center">
        <span className="text-sm text-dark-400">
          Ai deja cont?{" "}
          <button
            onClick={() => setCurrentView("login")}
            className="text-primary-400 hover:text-primary-300 font-medium"
          >
            Autentifică-te
          </button>
        </span>
      </div>
    </div>
  )
}

export default CheckoutAuthPrompt
