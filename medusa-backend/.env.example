# Carphacom Medusa Backend example environment
NODE_ENV=development
PORT=9000
HOST=127.0.0.1

# Replace with your local database values
DATABASE_URL=postgres://carphacom:change-me@127.0.0.1:5432/qubit_store
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
COOKIE_SECRET=change-me-generate-with-openssl-rand-hex-32

STORE_CORS=http://localhost:8000,http://127.0.0.1:8000
ADMIN_CORS=http://localhost:3000,http://127.0.0.1:3000
AUTH_CORS=http://localhost:3000,http://127.0.0.1:3000

MEDUSA_WORKER_MODE=shared
